# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Google Cloud Console → APIs & Services → Credentials.
# Restrict this key by HTTP referrer (your domain) before deploying.
VITE_GOOGLE_PLACES_API_KEY=

# Find via: https://developers.google.com/maps/documentation/places/web-service/place-id
# Search for "UP Telecom" near coordinates -15.7660948, -48.0406312 to get
# the correct Place ID (format ChIJ...).
VITE_GOOGLE_PLACE_ID=
